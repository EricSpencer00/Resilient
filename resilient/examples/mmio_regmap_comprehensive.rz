// base/size validation and overlap checks happen on the struct attributes.

// Valid: Standard register map declaration.
#[mmio(base = "0x40010000", size_bytes = "0x400")]
struct UART0 {
    int status_reg,
    int data_reg,
    int control_reg,
    int baud_rate,
}

// Valid: Different register layouts.
#[mmio(base = "0x40020000", size_bytes = "0x400")]
struct SPI_MASTER {
    int status,
    int control,
    int data_out,
    int data_in,
    int chip_select,
}

// Valid: Sparse register addresses are represented by the named fields;
// the current register-map pass validates the peripheral region itself.
#[mmio(base = "0x40030000", size_bytes = "0x400")]
struct ADC_CONTROLLER {
    int config,
    int channel_select,
    int result,
    int calibration,
}

fn init_uart() -> int {
