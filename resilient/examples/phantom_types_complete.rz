// RES-3184-3186: Phantom type validation example
// Phantom units carry compile-time meaning without runtime overhead.

#[phantom(units = "Length")]
struct Meters {
    int value,
}

#[phantom(units = "Length")]
struct Feet {
    int value,
}

fn total_length() -> int {
    let meters = new Meters { value: 42 };
    let feet = new Feet { value: 8 };
    return meters.value + feet.value;
}

fn main() -> int {
    return total_length();
}

main();
